            "periodMs": 100,
            "dutyCycle": 0.5,
            "fill": "paper",
            "stroke": "ink",
            "fade": false,
            "reveal": "flash"
          },
          {
            "kind": "rect",
            "t": { "startMs": 400, "inMs": 1, "holdMs": 600, "outMs": 0, "easing": "linear" },
            "x": 6,
            "y": 6,
            "w": 84,
