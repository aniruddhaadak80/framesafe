{
  "version": 1,
  "id": "continuity-breach",
  "title": "Continuity breach (intentional fail)",
  "summary": "A hard cut between two layouts, published with a declared continuity budget the clip does not meet. Its flash budget is wide open so only the continuity audit fails.",
  "technique": ["audit-demo", "hard-cut", "continuity"],
  "tags": ["intentional-fail", "continuity", "transition"],
  "fps": 24,
  "width": 1280,
  "height": 720,
  "durationMs": 5000,
  "supersample": 2,
  "background": "ink",
  "continuityBudget": 0.05,
  "maxAdjacentContrast": 1,
  "reducedMotion": {
    "holdFrame": 30,
    "note": "Frame 30 is the last frame before the cut, so the reduced-motion hold shows the state a viewer never gets to see the second half of."
  },
