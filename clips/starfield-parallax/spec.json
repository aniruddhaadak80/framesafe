{
  "version": 1,
  "id": "starfield-parallax",
  "title": "Depth field",
  "summary": "Three particle layers drift at different rates from one seeded generator, so depth is legible as differential motion rather than as blur.",
  "technique": ["parallax", "particles", "seeded-entropy"],
  "tags": ["space", "depth", "drift"],
  "fps": 24,
  "width": 1280,
  "height": 720,
  "durationMs": 6000,
  "supersample": 2,
  "background": "ink",
  "continuityBudget": 0.14,
  "maxAdjacentContrast": 0.5,
  "reducedMotion": {
    "holdFrame": 100,
    "note": "Particles are mid-flight at frame 100; the hold frame shows the field at rest rather than a separate static design."
  },
  "layers": [
    {
      "kind": "background",
      "name": "ink",
      "t": { "startMs": 0, "inMs": 400, "holdMs": 5200, "outMs": 400, "easing": "easeOutQuad" },
      "fill": "panel",
      "reveal": "fade"
    },
    {
      "kind": "particles",
      "name": "far",
      "t": { "startMs": 0, "inMs": 900, "holdMs": 4300, "outMs": 800, "easing": "easeOutQuad" },
      "count": 260,
      "seed": 11,
      "cx": 640,
      "cy": 360,
      "spreadX": 1500,
      "spreadY": 1000,
      "drift": 80,
      "size": 2.2,
      "fill": "subtle",
      "reveal": "drift"
    },
    {
      "kind": "particles",
      "name": "mid",
      "t": { "startMs": 100, "inMs": 900, "holdMs": 4200, "outMs": 800, "easing": "easeOutQuad" },
      "count": 90,
      "seed": 23,
      "cx": 640,
      "cy": 360,
      "spreadX": 1300,
      "spreadY": 860,
      "drift": 210,
      "size": 3.4,
      "fill": "muted",
      "reveal": "drift"
    },
    {
      "kind": "particles",
      "name": "near",
      "t": { "startMs": 200, "inMs": 900, "holdMs": 4100, "outMs": 800, "easing": "easeOutQuad" },
      "count": 24,
      "seed": 37,
      "cx": 640,
      "cy": 360,
      "spreadX": 1100,
      "spreadY": 700,
      "drift": 420,
      "size": 5,
      "fill": "accent",
      "reveal": "drift"
    },
    {
      "kind": "line",
      "name": "rule",
      "t": { "startMs": 1400, "inMs": 600, "holdMs": 3400, "outMs": 700, "easing": "easeOutCubic" },
      "x1": 540,
      "y1": 500,
      "x2": 740,
      "y2": 500,
      "stroke": "accent",
      "strokeWidth": 2,
      "reveal": "draw"
    },
    {
      "kind": "text",
      "name": "wordmark",
      "t": { "startMs": 1600, "inMs": 900, "holdMs": 3100, "outMs": 700, "easing": "easeOutCubic" },
      "text": "PARALLAX",
      "x": 640,
      "y": 536,
      "scale": 12,
      "align": "center",
      "tracking": 2.4,
      "stroke": "paper",
      "strokeWidth": 3,
      "reveal": "draw"
    },
    {
      "kind": "text",
      "name": "caption",
      "t": { "startMs": 2200, "inMs": 700, "holdMs": 2500, "outMs": 700, "easing": "easeOutQuad" },
      "text": "ONE SEED, THREE RATES",
      "x": 640,
      "y": 636,
      "scale": 6,
      "align": "center",
      "tracking": 3.2,
      "fill": "subtle",
      "strokeWidth": 2,
      "reveal": "mask"
    }
  ]
}
