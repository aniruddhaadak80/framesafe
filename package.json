{
  "name": "framesafe",
  "version": "0.1.0",
  "private": true,
  "description": "framesafe — Compile a motion-graphics spec into frame-exact renders with a per-frame digest manifest, then prove each clip reproducible, motion-safe and inside its declared continuity budget.",
  "license": "MIT",
  "author": "aniruddhaadak80",
  "repository": {
    "type": "git",
    "url": "https://github.com/aniruddhaadak80/framesafe.git"
  },
  "homepage": "https://github.com/aniruddhaadak80/framesafe",
  "bugs": {
    "url": "https://github.com/aniruddhaadak80/framesafe/issues"
  },
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  },
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "prepare": "prettier --write .",
    "render": "node packages/cli/dist/bin.js render all",
    "clips": "node packages/cli/dist/bin.js clips",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "turbo run dev --parallel",
    "check:skill-version": "node scripts/check-skill-version.mjs",
    "check:no-secrets": "node scripts/check-no-secrets.mjs",
    "check:theme-tokens": "node scripts/check-theme-tokens.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:public-hygiene": "node scripts/check-public-hygiene.mjs",
    "check:readme-commands": "node scripts/check-readme-commands.mjs",
    "check:vercel-services": "node scripts/check-vercel-services.mjs",
    "check:clip-specs": "python scripts/check-clip-specs.py",
    "check:manifests": "python scripts/check-manifests.py",
    "lint:python": "python -m ruff check services/engine",
    "typecheck:python": "python -m mypy services/engine/src",
    "pytest": "python -m pytest services/engine -q",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:skill-version && npm run check:no-secrets && npm run check:theme-tokens && npm run check:boundaries && npm run check:public-hygiene && npm run check:readme-commands && npm run check:vercel-services && npm run check:clip-specs && npm run check:manifests && npm run lint:python && npm run typecheck:python && npm test && npm run pytest && npm run build",
    "evals": "node scripts/run-evals.mjs",
    "prove:mcp": "node scripts/prove-mcp.mjs",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "cli",
    "typescript",
    "python",
    "self-hosted"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
